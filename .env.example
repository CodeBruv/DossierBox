# DossierBox — environment variable template (names only).
#
# Copy to .env.local before development and to the deployment
# environment's secret store before production. NEVER commit real
# values. Only variable names are listed here.
#
# Next.js requires NEXT_PUBLIC_ prefix for any env var exposed to the
# browser. DossierBox keeps ALL secrets server-side; nothing here is
# intended for client exposure.

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Authentication — REQUIRED for sign-in to function
# ---------------------------------------------------------------
# Auth.js v5 auto-detects the AUTH_* names; the NEXTAUTH_*/GOOGLE_* names are
# the v4 convention. DossierBox accepts either, but set ONE consistent set in
# every environment. If these are missing, the app redirects to
# /auth/sign-in?error=Configuration and Google sign-in appears unavailable.
# The server log names the specific missing variable on startup.
#
# Generate a secret with:  openssl rand -base64 32
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
#
# v4 equivalents (do not set both sets):
# NEXTAUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Optional. Omit on Vercel — the deployment URL is detected via trustHost.
# Set it for any other host, or for a custom domain.
# AUTH_URL=
# NEXTAUTH_URL=
#
# Authorised redirect URI to register in the Google Cloud console, one per
# environment (note: no trailing slash):
#   https://<your-domain>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google

# ---------------------------------------------------------------
# Database — REQUIRED
# ---------------------------------------------------------------
# The application connection. On Supabase this is normally the POOLED
# transaction-mode string (a *.pooler.supabase.com host on port 6543).
# The pooler cannot support server-side prepared statements, which is why
# src/auth/database.ts sets `prepare: false` — do not remove that.
# DATABASE_URL=
#
# Optional, and only used by tooling that issues DDL: `npm run db:migrate`
# and `npm run db:secure`. Those need a SESSION-mode connection as the role
# that owns the tables, which the pooler cannot provide. On Supabase this is
# the "Direct connection" string (db.<project-ref>.supabase.co on port 5432).
# When unset, the tooling falls back to DATABASE_URL.
# DATABASE_DIRECT_URL=
#
# Optional connection-pool tuning. Both have working defaults; set them only
# against a measured limit. The correct ceiling depends on the deployment's
# pooler quota — exhausting it fails requests rather than slowing them.
# DATABASE_POOL_MAX=        # max concurrent connections (default 3)
# DATABASE_IDLE_TIMEOUT=    # seconds before an idle connection closes (default 20)

# ---------------------------------------------------------------
# AI provider key (Block 8+ — NEVER in client bundle)
# ---------------------------------------------------------------
# AI_PROVIDER_KEY=

# ---------------------------------------------------------------
# Payments (Block 15+ — NEVER in client bundle)
# ---------------------------------------------------------------
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Storage (Block 11/13+ — private object storage)
# ---------------------------------------------------------------
# STORAGE_BUCKET_URL=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------
# Analytics (Block 18+)
# ---------------------------------------------------------------
# ANALYTICS_WRITE_KEY=

# ---------------------------------------------------------------
# Observability
# ---------------------------------------------------------------
# LOG_LEVEL=info
