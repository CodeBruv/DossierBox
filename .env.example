# DossierBox — environment variable template (names only).
#
# Copy to .env.local before development and to the deployment
# environment's secret store before production. NEVER commit real
# values. Only variable names are listed here.
#
# Next.js requires NEXT_PUBLIC_ prefix for any env var exposed to the
# browser. DossierBox keeps ALL secrets server-side; nothing here is
# intended for client exposure.

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Authentication (Block 2)
# ---------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=

# ---------------------------------------------------------------
# Database (Block 2+)
# ---------------------------------------------------------------
# DATABASE_URL=

# ---------------------------------------------------------------
# AI provider key (Block 8+ — NEVER in client bundle)
# ---------------------------------------------------------------
# AI_PROVIDER_KEY=

# ---------------------------------------------------------------
# Payments (Block 15+ — NEVER in client bundle)
# ---------------------------------------------------------------
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Storage (Block 11/13+ — private object storage)
# ---------------------------------------------------------------
# STORAGE_BUCKET_URL=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------
# Analytics (Block 18+)
# ---------------------------------------------------------------
# ANALYTICS_WRITE_KEY=

# ---------------------------------------------------------------
# Observability
# ---------------------------------------------------------------
# LOG_LEVEL=info
